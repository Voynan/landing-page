# Origem canônica da landing page. Decidido: apex sem www.
VITE_SITE_ORIGIN=https://voynan.com

# Endpoint HTTPS que recebe POST do formulário e responde { submissionId }.
# Decidido: entrega por Amazon SES. O endpoint HTTP ainda precisa ser criado
# (Lambda Function URL ou API Gateway que chame o SES) — SES não recebe POST
# do navegador. Ver docs/v1-external-blockers.md, seção 2.
VITE_CONTACT_ENDPOINT=

# Chave pública do provedor antispam. Provedor ainda não escolhido.
# O segredo de verificação fica somente no backend, nunca em VITE_*.
VITE_ANTISPAM_SITE_KEY=

# PostHog. Decidido: a v1 lança com analytics. Chaves ainda não fornecidas.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Precisa permanecer false em qualquer ambiente público.
VITE_ENABLE_DESIGN_SYSTEM=false
