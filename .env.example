# Canonical origin of the landing page. Apex, no www.
VITE_SITE_ORIGIN=https://voynan.com

# HTTPS endpoint that receives the contact form POST and answers
# { submissionId }. Deployed from functions/contact; see its README.
VITE_CONTACT_ENDPOINT=

# Cloudflare Turnstile site key. Public by design. The matching secret is a
# Lambda environment variable and must never carry a VITE_ prefix.
VITE_ANTISPAM_SITE_KEY=

# PostHog. Analytics is deferred and stays disabled for v1.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Must stay false in any public environment.
VITE_ENABLE_DESIGN_SYSTEM=false
